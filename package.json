{
  "name": "aurora-rewards",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start:local": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs",
    "package:release": "npm run build && python3 scripts/package_release.py",
    "dev": "uni --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "uni build",
    "build:weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "test": "node --test server/*.test.mjs scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "vue-tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.0",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vue-tsc": "2.2.12"
  },
  "overrides": {
    "@dcloudio/vite-plugin-uni": {
      "vite": "$vite"
    },
    "@vitejs/plugin-legacy": {
      "vite": "$vite"
    },
    "vue": "$vue",
    "@vue/server-renderer": "3.5.44",
    "@vue/compiler-core": "3.4.21",
    "@vue/compiler-dom": "3.4.21",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/shared": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "@vue/reactivity": "3.4.21",
    "@babel/core": "7.29.7",
    "@intlify/core-base": "9.14.5",
    "@intlify/message-resolver": "9.1.11",
    "adm-zip": "0.6.1",
    "express": "4.22.3",
    "body-parser": "1.20.6",
    "cookie": "0.7.2",
    "qs": "6.16.0",
    "send": "0.19.1",
    "path-to-regexp": "0.1.13",
    "jpeg-js": "0.4.4",
    "phin": "3.7.1",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.7",
    "source-map-js": "1.2.2",
    "ws": "8.22.0",
    "esbuild": "0.25.12"
  }
}
